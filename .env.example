# ─────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────
# DATABASE_URL  — the connection Prisma uses at runtime. For local dev this
# is a normal localhost Postgres. For Supabase, use the POOLED connection
# (port 6543, ?pgbouncer=true&connection_limit=1) so we play nice with
# PgBouncer's transaction pooling.
#
# Example (local):
#   postgresql://postgres:postgres@localhost:5432/shopify_profit_ops
# Example (Supabase pooled — paste from Project Settings → Database → Connection pooling):
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopify_profit_ops"
# DIRECT_URL — direct (non-pooled) connection, ONLY used by `prisma migrate`
# / `prisma db push`. Required when DATABASE_URL points at PgBouncer
# because PgBouncer transaction pooling doesn't support the prepared
# statements Prisma migrations rely on.
#
# ALWAYS SET THIS, even in local dev. For local Postgres, just set it to
# the same value as DATABASE_URL (no pooler involved).
#
# Example (Supabase direct — paste from Project Settings → Database → Connection string → URI):
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shopify_profit_ops"

# Public-facing URL of this app. Used for OAuth callbacks, the cron self-
# ping URLs, and the PDF render loopback. Locally: http://localhost:3000.
# In production on Render: https://your-service.onrender.com (or a
# custom domain you've mapped to the service).
APP_URL="http://localhost:3000"

# Shared secret that locks the /api/cron/* routes. When set, every request to
# a cron route (including the in-process self-pings) must send a matching
# `x-cron-secret` header — middleware returns 401 otherwise. Leave EMPTY in
# local dev to skip the check; ALWAYS set a long random value in production so
# nobody on the internet can trigger a sync / email blast. The in-process
# crons read this same var and attach the header automatically.
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────────────────
# Shopify
# ─────────────────────────────────────────────────────────────────────────
SHOPIFY_CREDENTIALS_ENCRYPTION_KEY="replace-with-a-long-random-secret"
SHOPIFY_ADMIN_API_VERSION="2026-01"
SHOPIFY_WEBHOOK_SECRET="replace-with-your-shopify-webhook-secret"
SHOPIFY_CLIENTID=""
SHOPIFY_CLIENT_SECRET=""
# Multi-merchant OAuth install flow (/api/shopify/oauth/install -> /callback).
# Reuses SHOPIFY_CLIENTID / SHOPIFY_CLIENT_SECRET / APP_URL above. The app's
# Allowed redirection URL in the Partner dashboard must include:
#   ${APP_URL}/api/shopify/oauth/callback
# Comma-separated Admin API scopes requested at install. Defaults to
# read_products,read_orders,read_customers when unset.
SHOPIFY_OAUTH_SCOPES=""

# Background sync cron.
# Opt-in: crons default OFF in development, ON in production. Set to "1" to run
# the hourly Shopify full-sync locally.
# ──── Unified data-refresh cron (Shopify + Meta + Instagram + BixGrow) ────
# Runs every 2 hours. Fans out per-store sync to every connected source in
# parallel. Replaces the old Shopify-only cron (the legacy env var below
# still works as an alias for back-compat).
ENABLE_DATA_REFRESH_CRON=""
# DATA_REFRESH_CRON_DISABLED="1"   # hard kill switch (overrides ENABLE_* above)
# DATA_REFRESH_CRON_MS="7200000"   # default: 2h = 7,200,000ms. Set 3600000 for 1h, 14400000 for 4h.
# DATA_REFRESH_CRON_URL=""         # default: http://127.0.0.1:$PORT/api/cron/refresh-all

# ──── Legacy Shopify-only knobs (still honoured for back-compat) ─────────
# Setting ENABLE_SHOPIFY_SYNC_CRON=1 also enables the unified data-refresh
# cron above, so existing .env files don't silently lose syncing.
ENABLE_SHOPIFY_SYNC_CRON=""
# Skip incremental sync if last sync ran more recently than this (minutes).
# Default: 30.
# SHOPIFY_SYNC_STALE_THRESHOLD_MIN=""

# ─────────────────────────────────────────────────────────────────────────
# Growth Agent
# ─────────────────────────────────────────────────────────────────────────
GROWTH_AGENT_DEFAULT_APPROVER="merchant"
GROWTH_AGENT_PRODUCT_CRAWLER_DEFAULT_URLS=""
GROWTH_AGENT_PRODUCT_CRAWLER_USER_AGENT="ShopifyProfitOpsBot/0.1"

# ─────────────────────────────────────────────────────────────────────────
# Ads / analytics integrations
# ─────────────────────────────────────────────────────────────────────────
META_ADS_CLIENT_ID=""
META_ADS_CLIENT_SECRET=""
# Per-brand bucketing for the weekly Meta Ads report (/weekly-summary export
# to PDF). JSON array of {brand, match} where `match` is a regex applied to
# the campaign name (case-insensitive). Order matters — the first matching
# rule wins. Leave unset to put every campaign in a single "All campaigns"
# bucket.
# Example: META_ADS_BRAND_RULES='[{"brand":"Bushido","match":"^Bushido"},{"brand":"Linda","match":"^Linda"}]'
META_ADS_BRAND_RULES=""

# ─────────────────────────────────────────────────────────────────────────
# Weekly + Monthly auto-reports
# ─────────────────────────────────────────────────────────────────────────
# Resend transactional email for the auto-generated weekly/monthly PDFs.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Verified-domain sender. Format: 'Display Name <reports@yourdomain.com>'.
# Must be a domain you've verified in your Resend dashboard.
REPORT_FROM_EMAIL=""
# Cron knobs.
# Opt-in: crons default OFF in development, ON in production. Set to "1" to run
# the weekly/monthly auto-report scheduler locally.
ENABLE_WEEKLY_REPORT_CRON=""
# WEEKLY_REPORT_CRON_DISABLED="1"           # hard kill switch (overrides ENABLE_* above)
# WEEKLY_REPORT_CRON_MS="300000"            # default: 5 min polling
# WEEKLY_REPORT_CRON_URL=""                 # default: http://127.0.0.1:$PORT/api/weekly-summary/cron/run

# ─── Daily digest → Telegram (SA-RPT-01) ──────────────────────────────────────
# Morning PDF report (yesterday's Shopify + Meta data) delivered at ~08:00
# Asia/Jerusalem to the owner's personal Telegram chat.
# 1. Create a bot via @BotFather → copy the token.
# 2. Message your bot once, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Cron knobs (same pattern as weekly-report).
ENABLE_DAILY_REPORT_CRON=""
# DAILY_REPORT_CRON_DISABLED="1"            # hard kill switch
# DAILY_REPORT_CRON_MS="300000"             # default: 5 min polling
# DAILY_REPORT_CRON_URL=""                  # default: http://127.0.0.1:$PORT/api/daily-report/cron/run

TIKTOK_ADS_CLIENT_ID=""
TIKTOK_ADS_CLIENT_SECRET=""
GA4_CLIENT_ID=""
GA4_CLIENT_SECRET=""

# ═════════════════════════════════════════════════════════════════════════
# Creative Studio
# ═════════════════════════════════════════════════════════════════════════

# ─── AI providers ────────────────────────────────────────────────────────
# Replicate (Flux family for images, Veo for video — M3).
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=""
# Override Replicate model IDs (defaults: flux-1.1-pro and flux-schnell).
CREATIVE_IMAGE_MODEL_DEFAULT=""
CREATIVE_IMAGE_MODEL_FAST=""

# Higgsfield (Soul for images, DoP for video).
# Verify endpoint paths against https://platform.higgsfield.ai docs.
HIGGSFIELD_API_KEY=""
HIGGSFIELD_API_BASE_URL=""          # default: https://api.higgsfield.ai/v1
HIGGSFIELD_IMAGE_MODEL=""           # default: soul
HIGGSFIELD_VIDEO_MODEL=""           # default: dop-v1

# Nano Banana — Google Gemini 2.5 Flash Image (image-only).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_API_BASE_URL=""              # default: https://generativelanguage.googleapis.com/v1beta
NANOBANANA_MODEL=""                 # default: gemini-2.5-flash-image-preview

# OpenAI — gpt-image-1 (image-only).
# Get a key at https://platform.openai.com/api-keys (account must have gpt-image-1 access).
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
OPENAI_IMAGE_MODEL="gpt-image-1"
OPENAI_ORG_ID=""                    # optional
# gpt-image-1 fidelity: "low" | "medium" | "high" | "auto". Default: "high"
# (sharp detail, legible labels, real skin). "high" costs ≈ 4× more per image
# than "medium" — set to "medium" or "low" only for cheap previews.
OPENAI_IMAGE_QUALITY=""

# Batch quality: "fast" (cheap previews) or "pro" (sharp output). Default: pro.
CREATIVE_BATCH_QUALITY=""
# Concurrent provider calls inside one batch job. Default: 3.
CREATIVE_PROVIDER_CONCURRENCY=""

# ─── Storage ─────────────────────────────────────────────────────────────
# Backend: "local" (default, writes under ./.creative-storage) or "r2"/"s3".
CREATIVE_STORAGE_BACKEND="local"
CREATIVE_STORAGE_LOCAL_DIR=""

# Only used when CREATIVE_STORAGE_BACKEND is r2/s3.
CREATIVE_BUCKET=""
CREATIVE_S3_ENDPOINT=""              # R2: https://<account_id>.r2.cloudflarestorage.com
CREATIVE_S3_REGION="auto"
CREATIVE_S3_ACCESS_KEY_ID=""
CREATIVE_S3_SECRET_ACCESS_KEY=""

# ─── M2 job queue ────────────────────────────────────────────────────────
# In-process cron that pings the worker route.
# Opt-in: crons default OFF in development, ON in production. Set to "1" to run
# the creative job worker locally.
ENABLE_CREATIVE_JOB_CRON=""
CREATIVE_JOB_CRON_DISABLED=""        # hard kill switch (overrides ENABLE_* above)
CREATIVE_JOB_CRON_MS=""              # default: 5000 (5s)
CREATIVE_JOB_CRON_URL=""             # default: http://127.0.0.1:$PORT/api/creative/jobs/worker
# Shared secret sent in x-creative-worker-secret. Set in production.
CREATIVE_WORKER_SECRET=""

# ─── M3 video gating ─────────────────────────────────────────────────────
# Set to "1" to allow UGC_VIDEO projects to generate actual video clips
# (otherwise UGC_VIDEO falls back to a still frame).
CREATIVE_VIDEO_ENABLED=""
# Hard cap on clips per batch (safety against surprise spend). Default: 10.
CREATIVE_MAX_VIDEO_BATCH=""
# Replicate video model override. Default: google/veo-3-fast (~$0.40/clip).
CREATIVE_VIDEO_MODEL_DEFAULT=""

# ═════════════════════════════════════════════════════════════════════════
# Outcome-measurement cron — closed-loop alert outcomes
# ═════════════════════════════════════════════════════════════════════════
# Runs daily at 02:00 Israel TZ. Scans resolved alerts ≥ 3 days old and
# writes their measured outcome back into Alert.payloadJson.outcome so the
# next report can show "✅ you reordered X → now selling Y".
# Opt-in for development (default OFF dev, ON prod).
ENABLE_OUTCOME_MEASUREMENT_CRON=""
# OUTCOME_MEASUREMENT_CRON_DISABLED="1"
# OUTCOME_MEASUREMENT_CRON_MS="600000"   # default: 10 min polling
# OUTCOME_MEASUREMENT_CRON_URL=""        # default: http://127.0.0.1:$PORT/api/cron/measure-outcomes

# ═════════════════════════════════════════════════════════════════════════
# Flashy — Israeli reviews/loyalty tool integration (optional)
# ═════════════════════════════════════════════════════════════════════════
# Single-account: FLASHY_ACCOUNT_ID="123456"
# Multi-account (JSON array of {storeId, accountId}):
# FLASHY_ACCOUNT_IDS_JSON='[{"storeId":"cm...","accountId":"123456"}]'
FLASHY_ACCOUNT_ID=""
FLASHY_ACCOUNT_IDS_JSON=""

# ═════════════════════════════════════════════════════════════════════════
# Auth & session — Supabase
# ═════════════════════════════════════════════════════════════════════════
# Required. The Supabase project the SaaS auth layer (magic links + session
# cookies) talks to. Get these values at Project Settings → API in Supabase.
# A fresh clone WILL NOT RUN without these — /accept-invite and every
# session-cookie read blows up server-side.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Optional — server-side service role key for admin operations that bypass
# RLS (rare — only used for invite-acceptance backfills).
SUPABASE_SERVICE_ROLE_KEY=""

# ═════════════════════════════════════════════════════════════════════════
# Public URL knobs
# ═════════════════════════════════════════════════════════════════════════
# Public-facing URL, used inside client components. Usually mirrors APP_URL
# but exposed to the browser bundle. Set on Render + local dev.
NEXT_PUBLIC_APP_URL=""

# ═════════════════════════════════════════════════════════════════════════
# Billing — Stripe
# ═════════════════════════════════════════════════════════════════════════
# Master flag. When "false" (default), every request is treated as if it
# has the "agency" tier (i.e. everything unlocked). Flip to "true" to
# enforce plan gates. See docs/BILLING_CHECKLIST.md before flipping.
BILLING_ENABLED="false"
# From Stripe Dashboard → Developers → API keys. Use the LIVE key in prod
# and the TEST key locally. sk_test_... vs sk_live_...
STRIPE_SECRET_KEY=""
# From Stripe Dashboard → Developers → Webhooks. Whichever endpoint you
# registered for this environment. whsec_...
STRIPE_WEBHOOK_SECRET=""
# Public price IDs — see BILLING_CHECKLIST.md for the product/price setup.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=""
NEXT_PUBLIC_STRIPE_PRICE_GROWTH=""
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=""

# ═════════════════════════════════════════════════════════════════════════
# Observability — Sentry
# ═════════════════════════════════════════════════════════════════════════
# @sentry/nextjs DSNs. Silent-fail audit (docs/SILENT-FAIL-AUDIT.md) marks
# 5 HIGH severity .catch() sites that need these DSNs live before they're
# credible. Server-only + client-exposed variants.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ═════════════════════════════════════════════════════════════════════════
# LLM providers — direct + tunnel
# ═════════════════════════════════════════════════════════════════════════
# Direct Anthropic access — used as the sprint-brief fallback when the BI
# agent tunnel is unavailable, and as the general JSON-completion path in
# lib/clients/anthropic-client.ts.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""                    # default: claude-opus-4-7
ANTHROPIC_API_BASE_URL=""             # default: https://api.anthropic.com

# ─── BI agent (analytics Q&A tunnel) ──────────────────────────────────
# Cloudflare tunnel that fronts the internal BI agent. Base URL only, no
# path — the client appends /ask. Bearer token in BI_AGENT_TOKEN. Set
# BI_AGENT_DISABLE=1 to short-circuit every BI call (useful during outages).
BI_AGENT_URL=""
BI_AGENT_TOKEN=""
BI_AGENT_DISABLE=""

# ─── Creative agent (briefs, marketing planner, prompt refinement) ────
# OPTIONAL: separate tunnel + token for the Creative agent. When unset,
# the client falls back to BI_AGENT_URL + /creative/ask (shared-tunnel
# legacy mode). When SET, it uses this URL directly and appends the path
# below (default /ask). See lib/clients/bi-agent-client.ts.
CREATIVE_AGENT_URL=""
CREATIVE_AGENT_TOKEN=""
CREATIVE_AGENT_PATH=""                # default when CREATIVE_AGENT_URL is set: /ask

# ═════════════════════════════════════════════════════════════════════════
# Missing bits from earlier sections
# ═════════════════════════════════════════════════════════════════════════
# Higgsfield API secret — companion to HIGGSFIELD_API_KEY above. Required
# in production (the client sends both as hf-api-key + hf-secret headers).
# Missing this triggers HIGGSFIELD_MOCK mode silently.
HIGGSFIELD_API_SECRET=""
# Force mock Higgsfield responses without failing (useful for CI / local
# dev when secrets aren't provisioned). Auto-activates when key/secret
# are missing; set explicitly to override.
HIGGSFIELD_MOCK=""

# Google OAuth — used by Search Console (GSC) integration only.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Product analytics (optional — Plausible only, no ad-tech).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=""       # override the CDN path if self-hosted
